<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.pointwallet.mapper.AttendanceMapper">

    <!-- 오늘 출석 여부 조회 -->
    <select id="countTodayAttendance"
            resultType="int">

        SELECT COUNT(*)
        FROM attendance_tbl
        WHERE user_id = #{userId}
          AND attendance_date = CURDATE()

    </select>

    <!-- 오늘 출석 내역 저장 -->
<!--  attendance_tbl(출석 테이블)에 데이터 저장하는 과정
1. auto increment로 attendance id 생성
2. useGeneratedKeys=true 로 DB가 만든 PK를 가져올 수 있게 만듦
3. keyColumn="attendance_id" 로 autoincrement의 컬럼명을 지정한다.
4. keyProperty="attendanceId" 로. DB에서 받아온 값을 JAVA DTO의 attenanceId필드에 넣는다.
  -->
    <insert id="insertTodayAttendance"
            parameterType="org.scoula.pointwallet.domain.AttendanceVO"
            useGeneratedKeys="true"
            keyProperty="attendanceId"
            keyColumn="attendance_id">

        INSERT INTO attendance_tbl (
            user_id,
            attendance_date
        )
        VALUES (
                   #{userId},
                   CURDATE()
               )

    </insert>

</mapper>