<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.scoula.feed.mapper.FeedMapper">
    <insert id="create" useGeneratedKeys="true" keyProperty="feedId">
        insert into feed_tbl(user_id , transaction_id, feed_type, content,visibility)
        values (#{userId}, #{transactionId},#{feedType},#{content},#{visibility})
    </insert>

    <resultMap id="transactionMap"
               type="org.scoula.feed.domain.TransactionVO">
        <id column="transaction_id"
            property="transactionId"/>
        <result column="receive_id"
                property="receiveId"/>
        <result column="spending_category_id"
                property="spendingCategoryId"/>
        <result column="transaction_type"
                property="transactionType"/>
    </resultMap>

    <resultMap id="senderProfileMap"
               type="org.scoula.feed.domain.ProfileSimpleVO">
        <id column="sender_profile_id"
            property="profileId"/>
        <result column="sender_nickname"
                property="nickname"/>
        <result column="sender_profile_image"
                property="profileImageName"/>
    </resultMap>
    <resultMap id="receiverProfileMap"
               type="org.scoula.feed.domain.ProfileSimpleVO">
        <id column="receiver_profile_id"
            property="profileId"/>
        <result column="receiver_nickname"
                property="nickname"/>
        <result column="receiver_profile_image"
                property="profileImageName"/>
    </resultMap>

    <resultMap id="categoryMap"
               type="org.scoula.feed.domain.CategoryVO">
        <id column="spending_category_id"
            property="spendingCategoryId"/>
        <result column="category_name"
                property="categoryName"/>
    </resultMap>

    <resultMap id="statMap"
               type="org.scoula.feed.domain.FeedStatVO">
        <result column="like_count" property="likeCount"/>
        <result column="comment_count" property="commentCount"/>
    </resultMap>

    <resultMap id="feedImagesMap" type="org.scoula.feed.domain.FeedImageVO">
        <id column="image_id" property="imageId"/>
        <result column="feed_id" property="feedId"/>
        <result column="image_name" property="imageName"/>
    </resultMap>

    <resultMap id="feedMap" type="org.scoula.feed.domain.FeedVO">
        <id column="feed_id" property="feedId"/>
        <result column="user_id" property="userId"/>
        <result column="transaction_id" property="transactionId"/>
        <result column="feed_type" property="feedType"/>
        <result column="content" property="content"/>
        <result column="visibility" property="visibility"/>

        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <association property="transaction" resultMap="transactionMap"/>
        <association property="category" resultMap="categoryMap"/>
        <association property="receiver" resultMap="receiverProfileMap"/>
        <association property="sender" resultMap="senderProfileMap"/>
        <association property="stat" resultMap="statMap"/>

        <collection property="images" resultMap="feedImagesMap"/>
    </resultMap>


    <select id="get" resultMap="feedMap">
        select
            a.feed_id,
            a.user_id,
            a.transaction_id,
            a.feed_type,
            a.content,
            a.visibility,
            a.created_at,
            a.updated_at,
            (
                SELECT COUNT(*)
                FROM feed_like_tbl fl
                WHERE fl.feed_id = a.feed_id
            ) AS like_count,

            (
                SELECT COUNT(*)
                FROM feed_comment_tbl fc
                WHERE fc.feed_id = a.feed_id
            ) AS comment_count,

            b.image_id,
            b.feed_id,
            b.image_name,
            c.transaction_id AS transaction_id,
            c.receive_id,
            c.spending_category_id,
            c.transaction_type,
            d.profile_id AS sender_profile_id,
            d.nickname AS sender_nickname,
            d.stored_name AS sender_profile_image,
            e.profile_id AS receiver_profile_id,
            e.nickname AS receiver_nickname,
            e.stored_name AS receiver_profile_image,
            f.spending_category_id,
            f.category_name
        from feed_tbl a

            left join feed_image_tbl b
                on a.feed_id = b.feed_id
            left join  financial_transaction_tbl c
                on a.transaction_id = c.transaction_id
            left join profile_tbl d
                on a.user_id = d.user_id
            left join profile_tbl e
                on c.receive_id = e.user_id
            left join spending_category_tbl f
                on c.spending_category_id = f.spending_category_id
        where a.feed_id = #{feedId}
        order by image_id
    </select>

    <select id="getList" resultType="org.scoula.feed.domain.FeedVO">
        SELECT * FROM feed_tbl ORDER BY created_at DESC
    </select>

    <select id="getMyList" resultType="org.scoula.feed.domain.FeedVO">
        SELECT * FROM feed_tbl WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <select id="getFriendList" resultType="org.scoula.feed.domain.FeedVO">
        SELECT
            f.*,
            u.user_name
        FROM feed_tbl f
                 JOIN user_tbl u
                      ON f.user_id = u.user_id
                 JOIN friend_tbl fr
                      ON f.user_id = fr.friend_user_id
        WHERE fr.user_id = #{userId}
          AND f.visibility IN ('PUBLIC','FRIEND')
        ORDER BY f.created_at DESC;

    </select>


    <delete id="delete">

        delete from feed_tbl where feed_id = #{feedId};
    </delete>

    <insert id="createFeedImage">
        insert into feed_image_tbl(image_id, feed_id, image_name)
        values(#{imageId}, #{feedId}, #{imageName})
    </insert>


    <select id="getImage" resultType="org.scoula.feed.domain.FeedImageVO">
        select * from feed_image_tbl where image_id = #{imageId};
    </select>

    <select id="getImages" resultType="org.scoula.feed.domain.FeedImageVO">
        select * from feed_image_tbl where feed_id = #{feedId}
    </select>

</mapper>