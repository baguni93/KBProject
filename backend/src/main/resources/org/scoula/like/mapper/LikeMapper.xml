<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.like.mapper.LikeMapper">

    <!-- =========================
         좋아요 존재 여부
         ========================= -->

    <select id="exists" resultType="java.lang.Boolean">
        SELECT COUNT(*)
        FROM feed_like_tbl
        WHERE feed_id = #{feedId}
          AND user_id = #{userId}
    </select>


    <!-- =========================
         좋아요 수
         ========================= -->

    <select id="getLikeCount" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM feed_like_tbl
        WHERE feed_id = #{feedId}
    </select>


    <!-- =========================
         피드 작성자
         ========================= -->

    <select id="getFeedOwner" resultType="java.lang.Integer">
        SELECT user_id
        FROM feed_tbl
        WHERE feed_id = #{feedId}
    </select>


    <!-- =========================
         좋아요 생성
         ========================= -->

    <insert id="create">
        INSERT INTO feed_like_tbl (
            feed_id,
            user_id
        )
        VALUES (
                   #{feedId},
                   #{userId}
               )
    </insert>


    <!-- =========================
         좋아요 삭제
         ========================= -->

    <delete id="delete">
        DELETE
        FROM feed_like_tbl
        WHERE feed_id = #{feedId}
          AND user_id = #{userId}
    </delete>


</mapper>