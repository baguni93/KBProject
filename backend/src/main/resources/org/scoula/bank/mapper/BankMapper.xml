<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.bank.mapper.BankMapper">

    <resultMap id="bankMap" type="org.scoula.bank.domain.BankVO">
        <id property="bankCode" column="bank_code"/>
        <result property="bankName" column="bank_name"/>
        <result property="bankLogoName" column="bank_logo_name"/>
        <result property="useYn" column="use_yn"/>
    </resultMap>

    <!-- 사용 중인 은행 목록 조회 -->
    <select id="findAllActive" resultMap="bankMap">
        SELECT
        bank_code,
        bank_name,
        bank_logo_name,
        use_yn
        FROM bank_tbl
        WHERE use_yn = 'Y'
        ORDER BY bank_name
    </select>

</mapper>